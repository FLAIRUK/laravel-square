{
    "name": "flairuk/laravel-square",
    "description": "Square payments for Laravel: the official Square PHP SDK, configured, plus webhooks, idempotency keys, money helpers, OAuth and a Web Payments card form.",
    "keywords": ["laravel", "square", "squareup", "payments", "webhooks", "web-payments-sdk", "api-client"],
    "homepage": "https://github.com/FLAIRUK/laravel-square",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Phil Graham",
            "homepage": "https://github.com/ijeffro",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0",
        "square/square": "^45.0|^46.0|^47.0"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "FLAIRUK\\Square\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FLAIRUK\\Square\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "format": "pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "FLAIRUK\\Square\\SquareServiceProvider"
            ],
            "aliases": {
                "Square": "FLAIRUK\\Square\\Facades\\Square"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
